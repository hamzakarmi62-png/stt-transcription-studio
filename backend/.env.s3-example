# ── التخزين السحابي الدائم للفيديوهات ────────────────────────────────────────
# انسخ هذه الأسطر إلى backend/.env واملأ القيم، ثم شغّل:
#     python setup_cloud_storage.py --check     (فحص فقط)
#     python setup_cloud_storage.py             (نقل المكتبة كاملة)
#
# STORAGE_BACKEND=s3 يجعل الدلو هو المصدر الحقيقي: الملفات تبقى بعد إطفاء
# الحاسوب، والقرص المحلي يصبح مجرد نسخة مؤقتة (كاش).

STORAGE_BACKEND=s3

# ── الخيار الموصى به: Backblaze B2 ──
# 10 GB مجاناً، والتنزيل مجاني حتى 3 أضعاف حجم المخزون،
# والأهم: التسجيل لا يطلب بطاقة بنكية إطلاقاً ("No credit card required").
#
# من لوحة التحكم:
#   1) Buckets → Create a Private Bucket → اسمه مثلاً stt-media
#   2) App Keys → Add a New Application Key → يعطيك keyID و applicationKey
#      (applicationKey يظهر مرة واحدة فقط — انسخه فوراً)
#   3) Endpoint و Region يظهران في صفحة الـ Bucket
#      شكل Endpoint:  https://s3.us-west-004.backblazeb2.com
S3_ENDPOINT=https://s3.<region>.backblazeb2.com
S3_REGION=<region>
S3_BUCKET=stt-media
S3_ACCESS_KEY=<keyID>
S3_SECRET_KEY=<applicationKey>

# ── Cloudflare R2 (10 GB مجاناً، تنزيل بلا رسوم — لكن يطلب بطاقة) ──
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto

# ── Oracle Object Storage (200 GB — يطلب بطاقة) ──
# S3_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
# S3_REGION=<region>          مثال: eu-frankfurt-1

# مدة صلاحية الرابط المؤقت للتشغيل (ثوانٍ)
S3_PRESIGN_SECONDS=3600
