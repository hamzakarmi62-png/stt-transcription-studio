# Whisper model size: tiny | base | small | medium | large-v3
WHISPER_MODEL=small
# Device: cpu or cuda (cuda needs faster-whisper's CUDA libs installed)
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Diarization: auto (pyannote if token present, else simple fallback) | pyannote | simple
DIARIZATION_METHOD=auto
# HuggingFace token required for pyannote.audio (https://huggingface.co/settings/tokens)
HF_TOKEN=

# Storage
UPLOAD_DIR=uploads
DB_PATH=data/app.db
MAX_UPLOAD_MB=200

# CORS (comma separated origins)
CORS_ORIGINS=http://localhost:5173